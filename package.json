{
  "name": "myfinance",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev -w @myfinance/api\" \"npm run dev -w @myfinance/web\"",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "setup": "docker compose up -d --wait postgres postgres-test && DATABASE_URL=postgresql://myfinance:myfinance@localhost:${POSTGRES_PORT:-5432}/myfinance npm run db:deploy && DATABASE_URL=postgresql://myfinance:myfinance@localhost:${POSTGRES_PORT:-5432}/myfinance npm run db:seed",
    "test": "npm run test:db:up && npm run test:ci",
    "test:workspaces": "DATABASE_URL_TEST=postgresql://myfinance:myfinance@localhost:5433/myfinance_test npm run test --workspaces --if-present",
    "test:ci": "npm run db:test:deploy && npm run test:workspaces",
    "test:db:up": "docker compose up -d --wait postgres-test",
    "db:migrate": "npm run prisma:migrate -w @myfinance/api",
    "db:deploy": "npm run prisma:deploy -w @myfinance/api",
    "db:test:deploy": "DATABASE_URL=postgresql://myfinance:myfinance@localhost:5433/myfinance_test npm run prisma:deploy -w @myfinance/api",
    "db:seed": "npm run prisma:seed -w @myfinance/api",
    "e2e": "npm run test:db:up && playwright test",
    "e2e:ui": "playwright test --ui"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.50.0",
    "concurrently": "^9.1.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "typescript-eslint": "^8.18.0"
  }
}
