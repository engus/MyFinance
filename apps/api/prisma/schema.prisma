generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AccountClass {
  ASSET
  LIABILITY
  EQUITY
}

enum AccountSubtype {
  BANK
  CASH
  BROKERAGE
  REAL_ESTATE
  VEHICLE
  SECURITY
  PRIVATE_BUSINESS
  COLLECTIBLE
  MORTGAGE
  LOAN
  CREDIT_CARD
  OTHER
}

enum CategoryKind {
  INCOME
  EXPENSE
}

enum SystemCategoryKey {
  OTHER_INCOME
  OTHER_EXPENSE
  UNREALIZED_GAIN
  UNREALIZED_LOSS
  INTEREST
  FEES
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
  OPENING_BALANCE
  LIABILITY_PAYMENT
  VALUATION
  REVERSAL
}

enum TransactionStatus {
  POSTED
  REVERSED
}

enum RecurrenceInterval {
  WEEK
  MONTH
  QUARTER
  YEAR
  CUSTOM
}

enum RecurringStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

enum ReconciliationMode {
  AUTO
  CONFIRM
}

enum ReconciliationStatus {
  PENDING
  APPLIED
  CANCELLED
}

enum RateSource {
  YAHOO
  MANUAL
}

enum AssetType {
  REAL_ESTATE
  VEHICLE
  SECURITY
  PRIVATE_BUSINESS
  COLLECTIBLE
  OTHER
}

enum ValuationSource {
  MANUAL
  MARKET
}

model User {
  id                  String              @id @default(uuid())
  email               String              @unique
  passwordHash        String
  functionalCurrency  String              @default("USD")
  displayCurrency     String              @default("USD")
  timezone            String              @default("UTC")
  reconciliationMode  ReconciliationMode  @default(AUTO)
  totpEnabled         Boolean             @default(false)
  totpSecretEncrypted String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  accounts            Account[]
  categories          Category[]
  transactions        Transaction[]
  recurringTemplates  RecurringTemplate[]
  reconciliations     Reconciliation[]
  sessions            Session[]
  loginChallenges     LoginChallenge[]
  recoveryCodes       RecoveryCode[]
  assets              AssetProfile[]
}

model Session {
  id         String   @id
  userId     String
  csrfToken  String
  userAgent  String?
  ipAddress  String?
  expiresAt  DateTime
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model LoginChallenge {
  id        String   @id
  userId    String
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model RecoveryCode {
  id        String    @id @default(uuid())
  userId    String
  codeHash  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id               String            @id @default(uuid())
  userId           String
  name             String
  class            AccountClass
  subtype          AccountSubtype
  currency         String
  institution      String?
  countryCode      String?
  region           String?
  isSystem         Boolean           @default(false)
  isArchived       Boolean           @default(false)
  version          Int               @default(0)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries          Entry[]
  recurringLines   RecurringLine[]
  reconciliations  Reconciliation[]
  assetProfile     AssetProfile?
  liabilityProfile LiabilityProfile?

  @@index([userId, isArchived])
}

model Category {
  id              String             @id @default(uuid())
  userId          String
  name            String
  kind            CategoryKind
  systemKey       SystemCategoryKey?
  isSystem        Boolean            @default(false)
  isArchived      Boolean            @default(false)
  affectsCashflow Boolean            @default(true)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries         Entry[]
  recurringLines  RecurringLine[]

  @@unique([userId, name])
  @@unique([userId, systemKey])
  @@index([userId, isArchived])
}

model Transaction {
  id                  String               @id @default(uuid())
  userId              String
  type                TransactionType
  status              TransactionStatus    @default(POSTED)
  description         String
  occurredOn          DateTime             @db.Date
  reversalOfId        String?              @unique
  replacementForId    String?              @unique
  metadata            Json?
  createdAt           DateTime             @default(now())
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries             Entry[]
  reversalOf          Transaction?         @relation("TransactionReversal", fields: [reversalOfId], references: [id], onDelete: SetNull)
  reversedBy          Transaction?         @relation("TransactionReversal")
  replacementFor      Transaction?         @relation("TransactionReplacement", fields: [replacementForId], references: [id], onDelete: SetNull)
  replacement         Transaction?         @relation("TransactionReplacement")
  recurringOccurrence RecurringOccurrence?
  assetValuation      AssetValuation?
  reconciliation      Reconciliation?

  @@index([userId, occurredOn])
  @@index([userId, type])
}

model Entry {
  id                 String      @id @default(uuid())
  transactionId      String
  accountId          String?
  categoryId         String?
  originalAmount     Decimal     @db.Decimal(24, 8)
  originalCurrency   String
  functionalAmount   Decimal     @db.Decimal(24, 8)
  functionalCurrency String
  fxRate             Decimal     @db.Decimal(24, 10)
  rateSource         RateSource
  rateDate           DateTime    @db.Date
  createdAt          DateTime    @default(now())
  transaction        Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  account            Account?    @relation(fields: [accountId], references: [id], onDelete: Restrict)
  category           Category?   @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([transactionId])
  @@index([accountId])
  @@index([categoryId])
}

model RecurringTemplate {
  id          String                @id @default(uuid())
  userId      String
  type        TransactionType
  description String
  payload     Json
  interval    RecurrenceInterval
  customDays  Int?
  nextRunDate DateTime              @db.Date
  status      RecurringStatus       @default(ACTIVE)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  lines       RecurringLine[]
  occurrences RecurringOccurrence[]

  @@index([userId, status, nextRunDate])
}

model RecurringLine {
  id             String            @id @default(uuid())
  templateId     String
  accountId      String?
  categoryId     String?
  originalAmount Decimal           @db.Decimal(24, 8)
  currency       String
  template       RecurringTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  account        Account?          @relation(fields: [accountId], references: [id], onDelete: Restrict)
  category       Category?         @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([templateId])
  @@index([accountId])
  @@index([categoryId])
}

model RecurringOccurrence {
  id            String            @id @default(uuid())
  templateId    String
  scheduledDate DateTime          @db.Date
  transactionId String            @unique
  createdAt     DateTime          @default(now())
  template      RecurringTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  transaction   Transaction       @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@unique([templateId, scheduledDate])
  @@index([templateId])
}

model Reconciliation {
  id                 String               @id @default(uuid())
  userId             String
  accountId          String
  reconciliationDate DateTime             @db.Date
  statedBalance      Decimal              @db.Decimal(24, 8)
  expectedBalance    Decimal              @db.Decimal(24, 8)
  delta              Decimal              @db.Decimal(24, 8)
  currency           String
  expectedVersion    Int
  status             ReconciliationStatus @default(PENDING)
  transactionId      String?              @unique
  expiresAt          DateTime
  createdAt          DateTime             @default(now())
  appliedAt          DateTime?
  user               User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  account            Account              @relation(fields: [accountId], references: [id], onDelete: Cascade)
  transaction        Transaction?         @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([accountId, reconciliationDate])
}

model ExchangeRate {
  id           String     @id @default(uuid())
  ownerKey     String     @default("MARKET")
  fromCurrency String
  toCurrency   String
  rate         Decimal    @db.Decimal(24, 10)
  rateDate     DateTime   @db.Date
  source       RateSource
  fetchedAt    DateTime   @default(now())

  @@unique([ownerKey, fromCurrency, toCurrency, rateDate, source])
  @@index([ownerKey, fromCurrency, toCurrency, rateDate])
}

model AssetProfile {
  id             String           @id @default(uuid())
  userId         String
  accountId      String           @unique
  type           AssetType
  countryCode    String?
  region         String?
  institution    String?
  ownershipShare Decimal          @default(100) @db.Decimal(7, 4)
  notes          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  account        Account          @relation(fields: [accountId], references: [id], onDelete: Cascade)
  valuations     AssetValuation[]

  @@index([userId])
}

model AssetValuation {
  id            String          @id @default(uuid())
  assetId       String
  valuationDate DateTime        @db.Date
  amount        Decimal         @db.Decimal(24, 8)
  currency      String
  source        ValuationSource
  transactionId String          @unique
  createdAt     DateTime        @default(now())
  asset         AssetProfile    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  transaction   Transaction     @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@unique([assetId, valuationDate, source])
  @@index([assetId, valuationDate])
}

model LiabilityProfile {
  id                 String    @id @default(uuid())
  accountId          String    @unique
  creditor           String?
  annualInterestRate Decimal?  @db.Decimal(9, 6)
  maturityDate       DateTime? @db.Date
  notes              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  account            Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
}
