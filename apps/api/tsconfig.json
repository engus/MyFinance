{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "noEmit": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@myfinance/contracts": ["../../packages/contracts/src/index.ts"]
    }
  },
  "include": ["src"],
  "exclude": ["dist", "tests"]
}
